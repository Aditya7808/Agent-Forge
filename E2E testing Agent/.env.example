# ===========================================
# E2E Testing Agent — Environment Variables
# ===========================================

# OpenAI (Default Provider)
OPENAI_API_KEY=your_openai_api_key_here

# Groq (Optional — uncomment if using Groq)
# GROQ_API_KEY=your_groq_api_key_here

# Azure OpenAI (Optional — uncomment if using Azure)
# AZURE_OPENAI_API_KEY=your_azure_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_LLM_MODEL=gpt-4
# AZURE_OPENAI_LLM_MODEL_DEPLOYMENT=your-deployment-name
