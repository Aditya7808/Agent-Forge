# Copy this file to .env and fill in your key.
# Either GEMINI_API_KEY or GOOGLE_API_KEY works — set whichever your account uses.

GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# Optional: where exported markdown reports are written. Defaults to ./reports
# REPORTS_DIR=./reports
