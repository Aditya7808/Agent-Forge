# =============================================================================
# audio_chat — environment variables
# Copy this file to `.env` and fill in your keys.
# =============================================================================

# --- OpenAI (required for default config) -----------------------------------
OPENAI_API_KEY=sk-...
# Optional — override for Azure OpenAI / proxies / vLLM
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- LLM ---------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# --- Embeddings --------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=64

# --- HuggingFace embeddings (only if EMBEDDING_PROVIDER=huggingface) ---------
# HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# HF_CACHE_DIR=./hf_cache

# --- Transcription -----------------------------------------------------------
TRANSCRIPTION_PROVIDER=openai
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# --- AssemblyAI (only if TRANSCRIPTION_PROVIDER=assemblyai) ------------------
# ASSEMBLYAI_API_KEY=
# ASSEMBLYAI_SPEAKER_LABELS=true
# ASSEMBLYAI_EXPECTED_SPEAKERS=2

# --- Qdrant vector store -----------------------------------------------------
# ":memory:" → ephemeral in-process (zero-config demo / tests)
# "http://localhost:6333" → self-hosted (see docker-compose.yml)
# "https://xyz.aws.cloud.qdrant.io" → Qdrant Cloud (set QDRANT_API_KEY too)
QDRANT_URL=:memory:
# QDRANT_API_KEY=
QDRANT_PREFER_GRPC=false
QDRANT_COLLECTION=audio_chat_default
QDRANT_UPSERT_BATCH_SIZE=256

# --- RAG behavior ------------------------------------------------------------
RETRIEVAL_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_CONTEXT_CHARS=8000

# --- Audio upload limits -----------------------------------------------------
MAX_AUDIO_MB=50

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
