# =============================================================================
# AI Real Estate Agent Team — environment template
# Copy this file to `.env` and fill in the keys for the providers you use.
# =============================================================================

# --- Required for property extraction --------------------------------------
FIRECRAWL_API_KEY=

# --- LLM provider selection ------------------------------------------------
# One of: gemini | openai | anthropic | ollama
REAL_ESTATE_LLM_PROVIDER=gemini

# --- Provider keys (only the one you select is required) -------------------
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Model overrides (optional; sensible defaults applied) -----------------
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_HOST=http://localhost:11434

# --- Caching & persistence -------------------------------------------------
REAL_ESTATE_CACHE=1
REAL_ESTATE_CACHE_TTL=21600
REAL_ESTATE_CACHE_DIR=.cache/real_estate
REAL_ESTATE_HISTORY_DB=.cache/real_estate/history.sqlite3

# --- Firecrawl tuning ------------------------------------------------------
FIRECRAWL_TIMEOUT=120
FIRECRAWL_MAX_RETRIES=3

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=0
