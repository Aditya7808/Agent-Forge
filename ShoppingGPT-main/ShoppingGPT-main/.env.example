# =============================================================================
# ShoppingGPT - Environment Configuration TEMPLATE
# =============================================================================
# This is a TEMPLATE file. Do NOT put real secrets here.
#
# Copy this file to `.env` and put your real values there:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/Mac)
#
# `.env` is gitignored. `.env.example` IS committed to git.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED: OpenAI API Key
# -----------------------------------------------------------------------------
# Used for chat completions (gpt-4o-mini) and embeddings (text-embedding-3-small).
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here


# -----------------------------------------------------------------------------
# OPTIONAL: Model Configuration
# -----------------------------------------------------------------------------
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.1


# -----------------------------------------------------------------------------
# OPTIONAL: Flask Server Configuration
# -----------------------------------------------------------------------------
FLASK_SECRET_KEY=
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=1


# -----------------------------------------------------------------------------
# OPTIONAL: Other Settings
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
CONVERSATION_MEMORY_K=20
